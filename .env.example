# Grade Evidence Certainty Agent — Environment Configuration
# Copy this file to .env and set your own secure values.
# NEVER commit .env to version control.

# HMAC-SHA256 audit trail signing key (minimum 16 characters)
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=change-me-to-a-secure-random-key

# LLM provider: mock | ollama | claude | openai
MODEL_PROVIDER=mock
